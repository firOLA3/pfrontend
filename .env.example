# Google OAuth Client IDs (Expo automatically inlines EXPO_PUBLIC_* variables)
# Web Client ID (required for Android & backend verification)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Optional iOS Client ID (also set iosUrlScheme in app.json for non-Firebase builds)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id.apps.googleusercontent.com
